{
  "opencollection": "1.0.0",
  "info": {
    "name": "Forithmus Challenge Platform 2fa pages API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "pages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Pages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/challenges/:slug/pages",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List all pages for a challenge, ordered by position.\nPublic challenges: anyone can view. Private: members only."
        },
        {
          "info": {
            "name": "Create Page",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/challenges/:slug/pages",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new custom page. Admin only."
        },
        {
          "info": {
            "name": "Get Page",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/challenges/:slug/pages/:page_slug",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_slug",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a single page by its slug.\nPublic challenges: anyone can view. Private: members only."
        },
        {
          "info": {
            "name": "Update Page",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/challenges/:slug/pages/:page_slug",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_slug",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a page's title or content. Admin only."
        },
        {
          "info": {
            "name": "Delete Page",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/challenges/:slug/pages/:page_slug",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_slug",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a page. Admin only."
        },
        {
          "info": {
            "name": "Reorder Pages",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/challenges/:slug/pages/reorder",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Reorder pages by providing a list of page IDs in desired order. Admin only."
        }
      ]
    }
  ],
  "bundled": true
