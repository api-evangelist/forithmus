        {
          "id": "b4898e9f-d684-43af-a085-2c488cb53410",
          "name": "Setup 2Fa",
          "request": {
            "name": "Setup 2Fa",
            "description": {
              "content": "Begin TOTP 2FA setup for the authenticated user.\n\nGenerates a new TOTP secret, encrypts it, stores it, and returns the secret\nalong with a QR code URI and 10 one-time recovery codes.\n\nIf 2FA is already enabled, this overwrites the pending (unconfirmed) setup.\nIf 2FA is already confirmed, the user must disable it first.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "2fa",
                "setup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
